# AdaDo Environment Configuration
# Copy to .env and fill in your values

# Base URL (no trailing slash)
ADADO_BASE_URL=https://yourdomain.com
ADADO_DOMAIN=yourdomain.com

# Shared secrets — generate with: openssl rand -hex 32
ADADO_DB_PASSWORD=change_me_in_production
ADADO_SECRET_KEY=change_me_in_production

# App-specific secrets
VAULTWARDEN_ADMIN_TOKEN=change_me
FIREFLY_APP_KEY=SomeRandomStringOf32CharsExactly

# n8n
N8N_USER=admin
N8N_PASSWORD=change_me

# Nextcloud
NEXTCLOUD_ADMIN=admin
NEXTCLOUD_PASSWORD=change_me

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=change_me

# Media directory (Jellyfin source)
MEDIA_DIR=/mnt/media

# Paperless consume inbox
CONSUME_DIR=./inbox

# Ollama (for Open WebUI — if running locally)
OLLAMA_URL=http://host.docker.internal:11434
